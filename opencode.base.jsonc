{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "openkilo",
    "opencode-skill-creator",
    "./plugins/superpowers.js"
  ],
  "mcp": {
    "infra-ops": {
      "type": "local",
      "command": ["infra-ops-mcp"],
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  }
}
